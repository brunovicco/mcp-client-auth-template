APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=mcp-client-auth-template

# --- OAuth 2.1 client (see docs/adr/0002-oauth21-native-client.md) ---
MCP_CLIENT_SERVER_URL=http://localhost:8000
MCP_CLIENT_SCOPE=openid profile

# Loopback redirect - must match the redirect_uri registered with the authorization
# server (statically for Entra, dynamically via CIMD/DCR for a generic AS).
MCP_CLIENT_REDIRECT_HOST=127.0.0.1
MCP_CLIENT_REDIRECT_PORT=8765
MCP_CLIENT_REDIRECT_PATH=/callback

# Persist tokens across runs; unset (empty) to fall back to in-memory-only storage.
MCP_CLIENT_TOKEN_STORAGE_PATH=~/.mcp-client-auth-template/tokens.json

# Option A: Microsoft Entra ID (client_id pre-registered in the Entra portal - see the
# server template's docs/adr/0002-oauth21-resource-server.md for why CIMD/DCR don't apply)
MCP_CLIENT_AUTH_PROVIDER=entra
MCP_CLIENT_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
MCP_CLIENT_ENTRA_CLIENT_ID=11111111-1111-1111-1111-111111111111
# MCP_CLIENT_ENTRA_CLIENT_SECRET=   # only for a confidential client; leave unset for PKCE-only

# Option B: generic OIDC authorization server (Auth0, Keycloak, WorkOS AuthKit, ...)
# MCP_CLIENT_AUTH_PROVIDER=generic
# Optional: a stable HTTPS URL serving this client's OAuthClientMetadata as JSON (CIMD).
# Leave unset to fall back to Dynamic Client Registration automatically.
# MCP_CLIENT_GENERIC_CLIENT_METADATA_URL=https://example.invalid/mcp-client-metadata.json

# Optional vendor-neutral OpenTelemetry traces (see docs/LLM_OBSERVABILITY.md).
# Network-silent unless an endpoint is explicitly set. Requires `uv sync --extra observability`.
# OTEL_SDK_DISABLED=false
# OTEL_SERVICE_NAME=mcp-client-auth-template
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development,service.version=0.1.0

# Optional Langfuse tracing (opt-in; see docs/LLM_OBSERVABILITY.md).
# Leave unset to keep tracing disabled. Requires `uv sync --extra tracing`.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_CAPTURE_CONTENT=false
