# Consumed by the network-silent production preflight. Production rejects placeholder/insecure
# endpoints before OAuth, browser launch, token access, DNS, or HTTP begins.
APP_ENV=development
SERVICE_NAME=mcp-client-auth-template

# --- OAuth 2.1 client (see docs/adr/0002-oauth21-native-client.md) ---
MCP_CLIENT_SERVER_URL=http://localhost:8000
MCP_CLIENT_SCOPE=openid profile
MCP_CLIENT_AUTH_MODE=interactive

# OAuth discovery egress policy. Production defaults fail closed: HTTPS + globally routable
# addresses only. This explicit escape is only for this localhost development example.
MCP_CLIENT_OAUTH_ALLOW_INSECURE_LOOPBACK=true
MCP_CLIENT_OAUTH_DNS_TIMEOUT_SECONDS=2.0
MCP_CLIENT_OAUTH_HTTP_TIMEOUT_SECONDS=10.0
MCP_CLIENT_OAUTH_MAX_RESPONSE_BYTES=1048576
MCP_CLIENT_OAUTH_MAX_REDIRECTS=5
MCP_CLIENT_OAUTH_MAX_HOSTS=16
MCP_CLIENT_OAUTH_CALLBACK_TIMEOUT_SECONDS=300.0
MCP_CLIENT_OAUTH_CALLBACK_MAX_REQUESTS=32

# Explicit HTTP and MCP operation budgets. Tool calls are attempted once; this template never
# retries a tool automatically because a future tool may have side effects.
MCP_CLIENT_HTTP_CONNECT_TIMEOUT_SECONDS=10.0
MCP_CLIENT_HTTP_READ_TIMEOUT_SECONDS=300.0
MCP_CLIENT_HTTP_WRITE_TIMEOUT_SECONDS=30.0
MCP_CLIENT_HTTP_POOL_TIMEOUT_SECONDS=10.0
MCP_CLIENT_TOOL_CALL_TIMEOUT_SECONDS=60.0
MCP_CLIENT_SHUTDOWN_TIMEOUT_SECONDS=10.0

# Loopback redirect - must match the redirect_uri registered with the authorization
# server (statically for Entra, dynamically via CIMD/DCR for a generic AS).
# Use an IP literal, not localhost or a wildcard/private-LAN binding.
MCP_CLIENT_REDIRECT_HOST=127.0.0.1
MCP_CLIENT_REDIRECT_PORT=8765
MCP_CLIENT_REDIRECT_PATH=/callback

# Persist tokens across runs; unset the variable to use the in-memory adapter explicitly.
MCP_CLIENT_TOKEN_STORAGE_PATH=~/.mcp-client-auth-template/tokens.json

# Option A: Microsoft Entra ID (client_id pre-registered in the Entra portal - see the
# server template's docs/adr/0002-oauth21-resource-server.md for why CIMD/DCR don't apply)
MCP_CLIENT_AUTH_PROVIDER=entra
MCP_CLIENT_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
MCP_CLIENT_ENTRA_CLIENT_ID=11111111-1111-1111-1111-111111111111
# In interactive mode this CLI is a public client: no client secret is accepted.

# Option B: generic OIDC authorization server (Auth0, Keycloak, WorkOS AuthKit, ...)
# MCP_CLIENT_AUTH_PROVIDER=generic
# Optional: a stable HTTPS URL serving this client's OAuthClientMetadata as JSON (CIMD).
# Leave unset to fall back to Dynamic Client Registration automatically.
# MCP_CLIENT_GENERIC_CLIENT_METADATA_URL=https://example.invalid/mcp-client-metadata.json

# Option C: non-interactive OAuth Client Credentials extension with generic OIDC.
# Switch both selectors, pre-register the confidential client at the authorization server, and
# inject MCP_CLIENT_CLIENT_CREDENTIALS_SECRET at process start from a secret manager. Never put
# that credential in this file or source control. CIMD/DCR and the loopback listener are not used;
# access tokens remain in memory even if MCP_CLIENT_TOKEN_STORAGE_PATH is configured above.
# MCP_CLIENT_AUTH_MODE=client_credentials
# MCP_CLIENT_AUTH_PROVIDER=generic
# MCP_CLIENT_CLIENT_CREDENTIALS_CLIENT_ID=mcp-machine-service

# Optional observability via a2a-otel-kit (see docs/OBSERVABILITY.md and
# docs/adr/0019-native-mcp-v2-observability.md). Network-silent unless A2A_OTEL_ENABLED=true
# and A2A_OTEL_OTLP_ENDPOINT are both set.
# A2A_OTEL_ENABLED=false
# A2A_OTEL_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# A2A_OTEL_OTLP_TIMEOUT_SECONDS=10.0
# A2A_OTEL_LOG_LEVEL=INFO
# A2A_OTEL_LOG_FORMAT=json
